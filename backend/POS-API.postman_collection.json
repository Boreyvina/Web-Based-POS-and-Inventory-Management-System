      "name": "8. Uploads",
      "item": [
        {
          "name": "Upload product image (admin)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/uploads/product-image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "uploads",
                "product-image"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "JPG, PNG, WEBP or GIF, under 2 MB"
                }
              ]
            },
            "description": "multipart/form-data with a single file field named \"image\".\n\nReturns { url } \u2014 store that value in products.image_url via POST /products or PUT /products/:id.\n\nIn Postman: Body > form-data, set the key type to File, then pick a file."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.url) pm.collectionVariables.set('imageUrl', json.data.url);",
                  "pm.test('Image uploaded', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete product image (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/uploads/product-image?url={{imageUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "uploads",
                "product-image"
              ],
              "query": [
                {
                  "key": "url",
                  "value": "{{imageUrl}}"
                }
              ]
            },
            "description": "Removes the file from disk. Clear products.image_url separately."
          },
          "response": []
        }
