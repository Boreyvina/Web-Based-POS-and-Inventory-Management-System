        {
          "name": "Expiring / expired stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/alerts/expiring?days=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "alerts",
                "expiring"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "30"
                }
              ]
            },
            "description": "Everything past its date or inside its warning window. Omit days to use each product's own warning period. Returns the total value at risk."
          },
          "response": []
        },
        {
          "name": "Create product (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "SKU is optional \u2014 the server generates one (BEV-0001) from the category when you leave it out. Upload the photo first (8. Uploads) and send the returned path as imageUrl.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barcode\": \"8850001000055\",\n  \"name\": \"Iced Tea 500ml\",\n  \"categoryId\": 1,\n  \"unit\": \"pcs\",\n  \"costPrice\": 0.4,\n  \"sellingPrice\": 0.75,\n  \"stockQuantity\": 60,\n  \"lowStockThreshold\": 15,\n  \"description\": \"Lemon flavour\",\n  \"imageUrl\": \"{{imageUrl}}\",\n  \"expiryDate\": \"2026-12-31\",\n  \"expiryWarningDays\": 14\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Update product (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "description": "Note: this endpoint never changes stock. Use the stock endpoint for that.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellingPrice\": 0.35,\n  \"lowStockThreshold\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Adjust stock (admin/cashier)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "stock"
              ]
            },
            "description": "quantityChange is a DELTA: +24 received, -3 damaged. Writes an inventory_log row.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"changeType\": \"restock\",\n  \"quantityChange\": 24,\n  \"note\": \"Delivery from supplier\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Deactivate product (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "description": "Soft delete \u2014 sale history stays intact."
          },
          "response": []
        },
        {
          "name": "Write off expired stock (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/write-off",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "write-off"
              ]
            },
            "description": "Reduces stock and records the loss in inventory_logs with change_type \"expired\", so expiry losses can be totalled separately from ordinary corrections. Omit quantity to write off everything.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 6,\n  \"note\": \"Past use-by date, binned\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Sales / POS",
      "item": [
        {
          "name": "Checkout (create sale)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales"
              ]
            },
            "description": "Runs in a single DB transaction: stock is checked, deducted and logged, or nothing happens at all.\n\npaymentMethod is one of: cash, card, qr.\n\nAn expired product is refused with 409 and a message naming the product and its date.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 5,\n      \"quantity\": 1,\n      \"discount\": 0.05\n    }\n  ],\n  \"paymentMethod\": \"cash\",\n  \"amountPaid\": 5,\n  \"discountAmount\": 0,\n  \"note\": \"Walk-in customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) pm.collectionVariables.set('saleId', json.data.id);",
                  "pm.test('Sale created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "List sales",
          "request": {
            "method": "GET",
