# ---- Server ----
PORT=5000
NODE_ENV=development
# Where the website is served from. In development any origin is accepted, so
# you only need to change this when you deploy for real.
CLIENT_URL=http://localhost:5173

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=pos_system

# Set these only when deploying to a hosted database (see DEPLOYMENT.md).
# DB_SSL=true
# DB_POOL_SIZE=2

# ---- JWT ----
# Generate a strong one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ---- Store info (printed on receipts) ----
STORE_NAME=My Convenience Store
STORE_ADDRESS=Street 123, Phnom Penh
STORE_PHONE=012 345 678
CURRENCY=USD
TAX_RATE=0

# ---- QR payments ----
# EASIEST OPTION: save the QR picture from your banking app into
# backend/uploads/ (or anywhere public) and point at it here. The checkout
# screen shows that image with the amount next to it, and the customer types
# the amount into their app.
QR_STATIC_IMAGE_URL=uploads/qr.png

# GENERATED OPTION: fill these in and the app builds a QR that already carries
# the amount, so the customer just scans and confirms. The values come from
# your bank — ask them, or read them off a QR they issued you. TEST A REAL SCAN
# BEFORE YOUR DEMO; every bank formats these slightly differently.
QR_ACQUIRER_ID=kh.gov.nbc.bakong
QR_ACCOUNT_ID=
QR_MERCHANT_TAG=29
QR_MERCHANT_NAME=MY STORE
QR_MERCHANT_CITY=PHNOM PENH
QR_MCC=5499
QR_COUNTRY=KH